# ========================================================
# AUDIFLOW - GUÍA DE CONFIGURACIÓN DEL ENTORNO INSTITUCIONAL
# ========================================================

# 1. SERVIDOR DE INFERENCIA DE IA (OLLAMA LOCAL O INSTITUCIONAL)
# Audiflow se conecta de forma estándar a Ollama.
#
# Opción A (Recomendada): Ollama ejecutándose en este mismo equipo
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Opción B: Si la institución tiene un servidor Ollama en red o nube:
# OLLAMA_BASE_URL=http://192.168.1.100:11434
# OLLAMA_MODEL=llama3.1:8b

# Opción C: Modelos livianos para laptops sin tarjeta gráfica dedicada:
# OLLAMA_MODEL=llama3.2:3b

# 2. SERVIDOR FASTAPI (BACKEND)
HOST=127.0.0.1
PORT=8000

# 3. BASE DE DATOS Y PERSISTENCIA (AUTÓNOMA)
# Audiflow utiliza persistencia automática en SQLite local (data/audiflow_local.db).
# NO es necesario configurar Supabase ni tener conexión a internet para evaluar el sistema.
#
# Si la institución desea conectar su propio proyecto de Supabase (opcional):
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave
# SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json
